# Development-only placeholders. Replace every credential before VPS use.
POSTGRES_DB=tima
POSTGRES_USER=tima
POSTGRES_PASSWORD=dev_postgres_change_me
POSTGRES_PORT=5432

REDIS_PASSWORD=dev_redis_change_me
REDIS_PORT=6379

MINIO_ROOT_USER=tima_dev
MINIO_ROOT_PASSWORD=dev_minio_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

APP_HTTP_PORT=8080
DEV_OTP=000000
TOKEN_PEPPER=replace_with_a_long_random_value
OTP_PEPPER=replace_with_a_different_long_random_value

# Required by the production compose file. Values are standard base64.
ESCROW_SIGNING_PRIVATE_KEY=
ESCROW_SIGNING_KEY_ID=escrow-ed25519-1
ESCROW_X25519_PUBLIC_KEY=
ESCROW_MLKEM768_PUBLIC_KEY=

# VPS DNS and ACME settings. These .test names intentionally cannot receive
# public certificates and must be replaced for staging.
API_DOMAIN=api.example.test
MINIO_DOMAIN=media.example.test
LIVEKIT_DOMAIN=livekit.example.test
ACME_EMAIL=dev@example.test

# Optional Phase 2 LiveKit settings.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev_livekit_secret_change_me_1234567890
LIVEKIT_HTTP_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT_START=50000
LIVEKIT_UDP_PORT_END=50020
LIVEKIT_BIND_ADDRESS=0.0.0.0
LIVEKIT_USE_EXTERNAL_IP=false
LIVEKIT_ENABLE_LOOPBACK_CANDIDATE=true

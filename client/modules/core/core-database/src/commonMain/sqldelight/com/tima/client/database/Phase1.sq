CREATE TABLE identity (
  device_id TEXT NOT NULL PRIMARY KEY,
  user_id TEXT NOT NULL,
  encrypted_key_handle BLOB NOT NULL
);

CREATE TABLE chat (
  chat_id TEXT NOT NULL PRIMARY KEY,
  peer_id TEXT NOT NULL,
  last_message_id TEXT,
  unread_count INTEGER NOT NULL DEFAULT 0,
  sync_cursor TEXT
);

CREATE TABLE message_revision (
  chat_id TEXT NOT NULL,
  message_id TEXT NOT NULL,
  revision_id TEXT NOT NULL,
  parent_revision_id TEXT,
  revision_number INTEGER NOT NULL,
  envelope BLOB NOT NULL,
  delivery_state TEXT NOT NULL,
  created_at_epoch_ms INTEGER NOT NULL,
  PRIMARY KEY (chat_id, message_id, revision_id)
);

CREATE TABLE sync_outbox (
  local_id TEXT NOT NULL PRIMARY KEY,
  idempotency_key TEXT NOT NULL UNIQUE,
  chat_id TEXT NOT NULL,
  request_path TEXT NOT NULL,
  envelope BLOB NOT NULL,
  state TEXT NOT NULL DEFAULT 'pending',
  retry_count INTEGER NOT NULL DEFAULT 0,
  next_attempt_epoch_ms INTEGER NOT NULL,
  created_at_epoch_ms INTEGER NOT NULL
);

CREATE INDEX sync_outbox_due
  ON sync_outbox(state, next_attempt_epoch_ms, created_at_epoch_ms);

CREATE TABLE crypto_session (
  peer_device_id TEXT NOT NULL PRIMARY KEY,
  encrypted_state BLOB NOT NULL,
  updated_at_epoch_ms INTEGER NOT NULL
);

CREATE TABLE media_queue (
  local_id TEXT NOT NULL PRIMARY KEY,
  media_id TEXT,
  chat_id TEXT NOT NULL,
  encrypted_manifest BLOB NOT NULL,
  state TEXT NOT NULL DEFAULT 'pending',
  retry_count INTEGER NOT NULL DEFAULT 0,
  created_at_epoch_ms INTEGER NOT NULL
);

CREATE TABLE media_cipher_blob (
  blob_id TEXT NOT NULL PRIMARY KEY,
  ciphertext BLOB NOT NULL
);

insertMediaQueue:
INSERT INTO media_queue(
  local_id, media_id, chat_id, encrypted_manifest, state, retry_count, created_at_epoch_ms
) VALUES (?, ?, ?, ?, ?, ?, ?);

updateMediaQueue:
UPDATE media_queue SET
  media_id = ?,
  encrypted_manifest = ?,
  state = ?,
  retry_count = ?
WHERE local_id = ?;

selectMediaQueueById:
SELECT * FROM media_queue WHERE local_id = ?;

selectPendingMediaQueue:
SELECT * FROM media_queue
WHERE state NOT IN ('SENT_TO_OUTBOX', 'TERMINAL')
ORDER BY created_at_epoch_ms;

deleteMediaQueue:
DELETE FROM media_queue WHERE local_id = ?;

deleteAllMediaQueue:
DELETE FROM media_queue;

upsertMediaCipherBlob:
INSERT OR REPLACE INTO media_cipher_blob(blob_id, ciphertext) VALUES (?, ?);

selectMediaCipherBlob:
SELECT ciphertext FROM media_cipher_blob WHERE blob_id = ?;

deleteMediaCipherBlob:
DELETE FROM media_cipher_blob WHERE blob_id = ?;

deleteAllMediaCipherBlobs:
DELETE FROM media_cipher_blob;

CREATE TABLE ui_chat_cache (
  chat_id TEXT NOT NULL PRIMARY KEY,
  position INTEGER NOT NULL,
  ciphertext BLOB NOT NULL
);

CREATE TABLE ui_message_cache (
  local_id TEXT NOT NULL PRIMARY KEY,
  chat_id TEXT NOT NULL,
  message_id TEXT,
  delivery_state TEXT NOT NULL,
  position INTEGER NOT NULL,
  ciphertext BLOB NOT NULL
);

CREATE INDEX ui_message_cache_chat_position
  ON ui_message_cache(chat_id, position);

CREATE INDEX ui_message_cache_server_id
  ON ui_message_cache(chat_id, message_id);

selectCachedChats:
SELECT * FROM ui_chat_cache ORDER BY position;

deleteCachedChats:
DELETE FROM ui_chat_cache;

insertCachedChat:
INSERT INTO ui_chat_cache(chat_id, position, ciphertext)
VALUES (?, ?, ?);

selectCachedMessages:
SELECT * FROM ui_message_cache WHERE chat_id = ? ORDER BY position;

deleteCachedMessagesForChat:
DELETE FROM ui_message_cache WHERE chat_id = ?;

insertCachedMessage:
INSERT INTO ui_message_cache(
  local_id, chat_id, message_id, delivery_state, position, ciphertext
) VALUES (?, ?, ?, ?, ?, ?);

deleteAllCachedMessages:
DELETE FROM ui_message_cache;

insertOutbox:
INSERT INTO sync_outbox(
  local_id, idempotency_key, chat_id, request_path, envelope,
  state, retry_count, next_attempt_epoch_ms, created_at_epoch_ms
) VALUES (?, ?, ?, ?, ?, 'pending', 0, ?, ?);

selectDueOutbox:
SELECT *
FROM sync_outbox
WHERE state IN ('pending', 'retry')
  AND next_attempt_epoch_ms <= ?
ORDER BY created_at_epoch_ms
LIMIT ?;

selectOutboxById:
SELECT *
FROM sync_outbox
WHERE local_id = ?;

markOutboxSending:
UPDATE sync_outbox
SET state = 'sending'
WHERE local_id = ? AND state IN ('pending', 'retry');

markOutboxSent:
UPDATE sync_outbox
SET state = 'sent'
WHERE local_id = ?;

markOutboxRetry:
UPDATE sync_outbox
SET state = 'retry',
    retry_count = retry_count + 1,
    next_attempt_epoch_ms = ?
WHERE local_id = ? AND state = 'sending';

markOutboxPending:
UPDATE sync_outbox
SET state = 'pending',
    next_attempt_epoch_ms = ?
WHERE local_id = ? AND state IN ('pending', 'retry', 'terminal');

markOutboxTerminal:
UPDATE sync_outbox
SET state = 'terminal'
WHERE local_id = ? AND state = 'sending';

deleteOutbox:
DELETE FROM sync_outbox
WHERE local_id = ?;

deleteAllOutbox:
DELETE FROM sync_outbox;

recoverSendingOutbox:
UPDATE sync_outbox
SET state = 'retry',
    next_attempt_epoch_ms = ?
WHERE state = 'sending';

insertRevision:
INSERT OR IGNORE INTO message_revision(
  chat_id, message_id, revision_id, parent_revision_id,
  revision_number, envelope, delivery_state, created_at_epoch_ms
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectCurrentRevision:
SELECT *
FROM message_revision
WHERE chat_id = ? AND message_id = ?
ORDER BY revision_number DESC
LIMIT 1;

markRevisionSent:
UPDATE message_revision
SET delivery_state = 'sent'
WHERE chat_id = ? AND message_id = ? AND revision_id = ?;

# Local reference snapshots (never part of the application repository).
/livekit-master git/
/kodium-main git/
/aiogram-dev-3.x/

# Reproducible tool downloads and build caches.
.tools/
schema/.tools/
.gradle/
**/.gradle/
**/build/
**/bin/
**/dist/
**/.cache/
*.class
*.jar
*.exe
*.test
coverage.out
/scripts/setup-windows-log.txt

# Runtime data and local configuration.
.env
.env.*
!.env.example
**/volumes/
**/*.pem
**/*.key
**/*.p8
**/secrets/

# Machine transfer pack (binaries / dumps). Keep the howto in git.
/perenos/**
!/perenos/HOW_TO_TRANSFER.md
!/perenos/env/
!/perenos/env/.env.example
!/perenos/env/NOTE.txt

# Editors and operating systems.
/.claude/
/.cursor/*
!/.cursor/skills/
!/.cursor/skills/**
.idea/
.vscode/
*.code-workspace
.DS_Store
Thumbs.db
Desktop.ini
